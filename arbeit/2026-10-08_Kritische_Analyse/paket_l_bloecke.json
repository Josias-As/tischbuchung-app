 {
  "nr": "L1",
  "control": "ddStart",
  "prop": "Items",
  "neu": "With(\n  { minutenJetzt: Hour(Now())*60 + Minute(Now()) },\n  With(\n    {\n      minutenStart:\n        If(\n          dpDatum.SelectedDate = Today(),\n          30 * RoundUp(minutenJetzt / 30, 0),\n          8 * 60\n        ),\n      minutenEnde: 22 * 60\n    },\n    ForAll(\n      Sequence(Max(0, RoundDown((minutenEnde - minutenStart) / 30, 0)), 0),\n      With(\n        { m: minutenStart + Value * 30 },\n        { Value: Text(Time(RoundDown(m / 60, 0), Mod(m, 60), 0), \"hh:mm\") }\n      )\n    )\n  )\n)",
  "titel": "Letzte Startzeit 21:30 statt 22:00",
  "art": "ersetzen",
  "de": "With(\n  { minutenJetzt: Hour(Now())*60 + Minute(Now()) };\n  With(\n    {\n      minutenStart:\n        If(\n          dpDatum.SelectedDate = Today();\n          30 * RoundUp(minutenJetzt / 30; 0);\n          8 * 60\n        );\n      minutenEnde: 22 * 60\n    };\n    ForAll(\n      Sequence(Max(0; RoundDown((minutenEnde - minutenStart) / 30; 0)); 0);\n      With(\n        { m: minutenStart + Value * 30 };\n        { Value: Text(Time(RoundDown(m / 60; 0); Mod(m; 60); 0); \"hh:mm\") }\n      )\n    )\n  )\n)",
  "orig": "With(\n  { minutenJetzt: Hour(Now())*60 + Minute(Now()) },\n  With(\n    {\n      minutenStart:\n        If(\n          dpDatum.SelectedDate = Today(),\n          30 * RoundUp(minutenJetzt / 30, 0),\n          8 * 60\n        ),\n      minutenEnde: 22 * 60\n    },\n    ForAll(\n      Sequence(RoundDown((minutenEnde - minutenStart) / 30, 0) + 1, 0),\n      With(\n        { m: minutenStart + Value * 30 },\n        { Value: Text(Time(RoundDown(m / 60, 0), Mod(m, 60), 0), \"hh:mm\") }\n      )\n    )\n  )\n)",
  "orig_de": "With(\n  { minutenJetzt: Hour(Now())*60 + Minute(Now()) };\n  With(\n    {\n      minutenStart:\n        If(\n          dpDatum.SelectedDate = Today();\n          30 * RoundUp(minutenJetzt / 30; 0);\n          8 * 60\n        );\n      minutenEnde: 22 * 60\n    };\n    ForAll(\n      Sequence(RoundDown((minutenEnde - minutenStart) / 30; 0) + 1; 0);\n      With(\n        { m: minutenStart + Value * 30 };\n        { Value: Text(Time(RoundDown(m / 60; 0); Mod(m; 60); 0); \"hh:mm\") }\n      )\n    )\n  )\n)",
  "pfad": "Screen1 > conBuchungDialog > ddStart"
 },
