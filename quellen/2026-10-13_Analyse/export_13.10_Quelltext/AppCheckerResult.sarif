d":"app-UnusedVariables","ruleIndex":6,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.varSpinnerWinkel"}},"logicalLocations":[{"fullyQualifiedName":"App.varSpinnerWinkel"}],"properties":{"module":"App","type":"App","member":"varSpinnerWinkel"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ScreenHasManyControls","ruleIndex":8,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1"}},"logicalLocations":[{"fullyQualifiedName":"Screen1"}],"properties":{"module":"Screen1","type":"Screen1"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByService","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly on large data sets. The \"{0}\" operation is not supported by this connector."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint","messageStrings":{"issue":{"text":"Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"acc-ReadableScreenNameNeeded","messageStrings":{"issue":{"text":"Revise screen name"}},"properties":{"howToFix":["Give the screen  a title that describes what's on the screen or what it's used for."],"whyFix":"People who are blind, have low vision, or a reading disability rely on screen titles to navigate using the screen reader. ","level":"Low","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedVariables","messageStrings":{"issue":{"text":"Nicht verwendete Variable"}},"properties":{"howToFix":["Entfernen Sie die nicht verwendete Variable."],"whyFix":"Diese Variable ist deklariert, wird aber von keinem Steuerelement referenziert und daher nicht benötigt.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"Die Sammlung wird initialisiert, aber nie aktualisiert"}},"properties":{"howToFix":["Ersetzen Sie „Collect“ oder „ClearCollect“ durch eine benannte Formel in „App.Formulas“. Beispiel: MyTable = Filter(Quelle, Bedingung). Benannte Formeln werden berechnet, sobald sich ihre Eingaben ändern, und verursachen nicht die Überwachungskosten einer Abfrage."],"whyFix":"Sammlungen sollen aktualisiert werden. Power Apps erledigt zusätzliche Arbeit, um jede Sammlung nachzuverfolgen, sodass alles, was davon abhängt, synchron bleibt, wenn sich die Daten ändern. Wenn sich die Daten nach ihrer Festlegung nicht mehr ändern, ist dieser Nachverfolgungsaufwand umsonst. Eine benannte Formel liefert dieselben Daten ohne zusätzliche Kosten.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ScreenHasManyControls","messageStrings":{"issue":{"text":"Zu viele Steuerelemente auf einem Bildschirm."}},"properties":{"howToFix":["Reduzieren Sie die Anzahl von Steuerelementen auf dem Bildschirm.","Alternativ dazu können Sie die App in weitere Bildschirme unterteilen, um die Komplexität pro Bildschirm zu verringern.","Verwenden Sie Komponenten, um gruppierte Steuerelemente zusammenzuführen, die auf allen Bildschirmen identisch sind, und so die Duplizierung zu reduzieren.","Verwenden Sie Kataloge, um eine Reihe sich wiederholender ähnlicher Steuerelemente darzustellen.","Teilen Sie die App in mehrere Apps auf, sodass jede App klein und leistungsfähig ist."],"whyFix":"Jedes Steuerelement beansprucht Ressourcen, und eine App reagiert möglicherweise langsam oder gar nicht mehr, wenn ein Bildschirm zu viele Steuerelemente aufweist. Die geschätzte Komplexität von \"Screen1\" ist 396 und überschreitet damit den maximal empfohlenen Schwellenwert (300).","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}